# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model used for generation (any OpenRouter model id)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Local embedding model (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB persistence directory
CHROMA_DIR=./data/chroma

# Directory where uploaded PDFs are stored
UPLOAD_DIR=./data/uploads

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval
TOP_K=4

# OCR fallback for scanned/image-only PDF pages (leave blank if on PATH)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
POPPLER_PATH=C:\path\to\poppler\Library\bin

# ---------------------------------------------------------------------------
# Week 4 — retrieval strategy toggles
# All default to false so the baseline is exactly the Week 3 app.
# Turn ON exactly ONE at a time so a hit-rate change is attributable.
# ---------------------------------------------------------------------------

# Hybrid search: BM25 keyword search fused with dense vector search (RRF)
HYBRID_ENABLED=false
CANDIDATE_K=20          # candidates each retriever contributes before fusion
RRF_K=60                # RRF damping constant (60 = original paper)

# Cross-encoder reranking (downloads ~90MB on first use)
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20

# LLM query rewriting (costs one extra LLM call per query)
REWRITE_ENABLED=false
REWRITE_MODEL=          # blank = reuse OPENROUTER_MODEL

# MMR diversity filter
MMR_ENABLED=false
MMR_LAMBDA=0.7          # 1.0 = pure relevance, 0.0 = pure diversity
