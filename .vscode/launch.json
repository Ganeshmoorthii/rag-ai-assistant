{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--port",
                "8000"
            ],
            // uvicorn resolves "app.main:app" relative to the working
            // directory, so this must be backend/ or the import fails.
            "cwd": "${workspaceFolder}/backend",
            "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
            // --reload spawns a child process; without this, breakpoints
            // only bind in the parent and never hit.
            "subProcess": true,
            "console": "integratedTerminal",
            "jinja": true
        }
    ]
}
